---
/**
 * Onda Conecta — Banner de Consentimento de Cookies (LGPD, GDPR & Google Consent Mode v2)
 * Barra inferior compacta e não-intrusiva (evita sobreposição de conteúdo e anúncios).
 */
const currentLocale = Astro.currentLocale || 'pt'
const isEn = currentLocale === 'en'
const isEs = currentLocale === 'es'

const texts = {
  title: isEn ? 'Privacy & Cookies' : isEs ? 'Privacidad y Cookies' : 'Privacidade & Cookies',
  message: isEn
    ? 'We use essential cookies and advertising/analytics cookies (such as Google AdSense) to improve your experience.'
    : isEs
      ? 'Utilizamos cookies esenciales y cookies de análisis y publicidad (como Google AdSense) para mejorar su experiencia.'
      : 'Utilizamos cookies essenciais e de análise/publicidade (como Google AdSense) para melhorar sua experiência.',
  privacyLinkText: isEn ? 'Privacy Policy' : isEs ? 'Política de Privacidad' : 'Política de Privacidade',
  acceptAll: isEn ? 'Accept All' : isEs ? 'Aceptar' : 'Aceitar',
  essentialOnly: isEn ? 'Essential Only' : isEs ? 'Esenciales' : 'Essenciais'
}
---

<aside
  id='cookie-consent-banner'
  role='region'
  aria-label={texts.title}
  class='fixed bottom-0 inset-x-0 z-40 hidden border-t border-border/80 bg-background/95 px-4 py-3 shadow-lg backdrop-blur-md transition-all duration-300 translate-y-full opacity-0 dark:bg-card/95'
>
  <div class='mx-auto flex max-w-7xl flex-col items-start justify-between gap-3 sm:flex-row sm:items-center'>
    <p class='text-xs leading-relaxed text-muted-foreground sm:text-sm'>
      <strong class='font-semibold text-foreground'>{texts.title}:</strong>{' '}
      {texts.message}{' '}
      <a
        href='/privacidade'
        class='font-medium text-primary underline underline-offset-4 hover:text-primary/80 transition-colors whitespace-nowrap'
      >
        {texts.privacyLinkText}
      </a>.
    </p>

    <div class='flex shrink-0 items-center gap-2 self-end sm:self-center'>
      <button
        type='button'
        id='btn-cookie-essential'
        class='inline-flex items-center justify-center rounded-lg border border-input bg-background px-3 py-1.5 text-xs font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring'
      >
        {texts.essentialOnly}
      </button>
      <button
        type='button'
        id='btn-cookie-accept-all'
        class='inline-flex items-center justify-center rounded-lg bg-primary px-3.5 py-1.5 text-xs font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring'
      >
        {texts.acceptAll}
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  ;(function () {
    const CONSENT_KEY = 'ondaconecta_cookie_consent'

    window.dataLayer = window.dataLayer || []
    function gtag() {
      window.dataLayer.push(arguments)
    }

    function updateGoogleConsent(status) {
      if (typeof window.gtag === 'function') {
        if (status === 'all') {
          window.gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted'
          })
        } else {
          window.gtag('consent', 'update', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied'
          })
        }
      }
      try {
        window.dispatchEvent(new CustomEvent('ondaconecta:consent-updated', { detail: status }))
      } catch (e) {}
    }

    function initCookieBanner() {
      const banner = document.getElementById('cookie-consent-banner')
      if (!banner) return

      let savedConsent = null
      try {
        savedConsent = localStorage.getItem(CONSENT_KEY)
      } catch (e) {}

      if (savedConsent) {
        updateGoogleConsent(savedConsent)
        banner.classList.add('hidden')
        return
      }

      banner.classList.remove('hidden')
      setTimeout(() => {
        banner.classList.remove('translate-y-full', 'opacity-0')
        banner.classList.add('translate-y-0', 'opacity-100')
      }, 300)

      const btnAcceptAll = document.getElementById('btn-cookie-accept-all')
      const btnEssential = document.getElementById('btn-cookie-essential')

      function closeBanner(type) {
        try {
          localStorage.setItem(CONSENT_KEY, type)
        } catch (e) {}
        updateGoogleConsent(type)

        banner.classList.remove('translate-y-0', 'opacity-100')
        banner.classList.add('translate-y-full', 'opacity-0')
        setTimeout(() => {
          banner.classList.add('hidden')
        }, 300)
      }

      if (btnAcceptAll && !btnAcceptAll.dataset.bound) {
        btnAcceptAll.dataset.bound = 'true'
        btnAcceptAll.addEventListener('click', () => closeBanner('all'))
      }

      if (btnEssential && !btnEssential.dataset.bound) {
        btnEssential.dataset.bound = 'true'
        btnEssential.addEventListener('click', () => closeBanner('essential'))
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCookieBanner)
    } else {
      initCookieBanner()
    }
  })()
</script>
