---
interface Props {
  headings?: { depth: number; slug: string; text: string }[]
  lang?: string
}

const { headings = [], lang = 'pt' } = Astro.props

// Filter to only h2 and h3 headings
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3)

// Group h3 headings under their parent h2
interface TocItem {
  slug: string
  text: string
  depth: number
  children: TocItem[]
}

const groupedHeadings: TocItem[] = []
let currentH2: TocItem | null = null

tocHeadings.forEach(heading => {
  if (heading.depth === 2) {
    currentH2 = {
      slug: heading.slug,
      text: heading.text,
      depth: heading.depth,
      children: []
    }
    groupedHeadings.push(currentH2)
  } else if (heading.depth === 3 && currentH2) {
    currentH2.children.push({
      slug: heading.slug,
      text: heading.text,
      depth: heading.depth,
      children: []
    })
  }
})

// Mapeamento dinâmico de tradução para o título da barra lateral
const titleMap: Record<string, string> = {
  pt: 'Sobre esta página',
  en: 'On This Page',
  es: 'En esta página'
}

const tocTitle = titleMap[lang] || 'Sobre esta página'
---

{
  groupedHeadings.length > 0 && (
    <div class='sticky top-24 flex max-h-[calc(100vh-7rem)] flex-col'>
      {/* Cabeçalho do Índice com tradução correta */}
      <div class='mb-3 flex shrink-0 items-center gap-2'>
        <span class='bg-primary/80 h-1.5 w-1.5 rounded-full' />
        <h3 class='text-muted-foreground text-xs font-semibold tracking-wider uppercase'>
          {tocTitle}
        </h3>
      </div>

      {/* Lista com rolagem nativa suave e fonte compacta (2px menor que o parágrafo principal: text-sm) */}
      <div class='scrollbar-thin scrollbar-thumb-border hover:scrollbar-thumb-muted-foreground/30 overscroll-contain overflow-y-auto pr-2'>
        <nav aria-label='Índice do artigo'>
          <ul class='space-y-2'>
            {groupedHeadings.map(item => (
              <li>
                <a
                  href={`#${item.slug}`}
                  class='toc-link text-muted-foreground hover:text-foreground flex items-start gap-2 text-left text-sm leading-snug transition-colors'
                  data-heading-link={item.slug}
                  data-depth='0'
                >
                  <span
                    class='toc-indicator bg-primary/40 mt-1.5 inline-block h-0.5 w-2.5 shrink-0 transition-colors'
                    data-link={item.slug}
                  />
                  <span class='line-clamp-2'>{item.text}</span>
                </a>

                {item.children.length > 0 && (
                  <ul class='mt-1.5 ml-3.5 space-y-1.5 border-l border-border/40 pl-2'>
                    {item.children.map(child => (
                      <li>
                        <a
                          href={`#${child.slug}`}
                          class='toc-link text-muted-foreground/80 hover:text-foreground flex items-start gap-1.5 text-left text-[13px] leading-snug transition-colors'
                          data-heading-link={child.slug}
                          data-depth='1'
                        >
                          <span
                            class='toc-indicator bg-primary/30 mt-1.5 inline-block h-0.5 w-2 shrink-0 transition-colors'
                            data-link={child.slug}
                          />
                          <span class='line-clamp-2'>{child.text}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  )
}

<script>
  const HEADER_OFFSET = 110

  let currentScrollHandler: (() => void) | null = null

  const initializeToc = () => {
    // Limpar listener anterior em transições de página
    if (currentScrollHandler) {
      window.removeEventListener('scroll', currentScrollHandler)
      currentScrollHandler = null
    }

    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link')
    if (!links.length) return

    // Mapear todos os IDs válidos presentes no TOC
    const validIds = new Set<string>()
    links.forEach(link => {
      const href = link.getAttribute('href') || ''
      const cleanId = href.replace(/^#/, '')
      validIds.add(cleanId)
      try {
        validIds.add(decodeURIComponent(cleanId))
      } catch (_) {}
    })

    // Selecionar apenas cabeçalhos do artigo que realmente estão no TOC
    const articleContainer = document.getElementById('content') || document
    const rawHeadings = articleContainer.querySelectorAll<HTMLElement>('h2[id], h3[id]')
    const sections = Array.from(rawHeadings).filter(h => {
      const id = h.id
      return validIds.has(id) || validIds.has(decodeURIComponent(id))
    })

    let activeId = ''

    const updateActiveLink = () => {
      links.forEach(link => {
        const linkHref = link.getAttribute('href') || ''
        const rawHrefId = linkHref.replace(/^#/, '')
        let decodedHrefId = rawHrefId
        try {
          decodedHrefId = decodeURIComponent(rawHrefId)
        } catch (_) {}

        const indicator = link.querySelector('.toc-indicator')
        const isActive =
          rawHrefId === activeId ||
          decodedHrefId === activeId ||
          link.getAttribute('data-heading-link') === activeId

        if (isActive) {
          link.classList.add('font-medium', 'text-foreground')
          link.classList.remove('text-muted-foreground', 'text-muted-foreground/80')
          if (indicator) {
            indicator.classList.add('bg-primary')
            indicator.classList.remove('bg-primary/40', 'bg-primary/30')
          }
        } else {
          link.classList.remove('font-medium', 'text-foreground')
          link.classList.add('text-muted-foreground')
          if (indicator) {
            indicator.classList.remove('bg-primary')
            indicator.classList.add('bg-primary/40')
          }
        }
      })
    }

    // Identificar o cabeçalho ativo baseado na posição de rolagem
    const findActiveHeading = () => {
      const scrollY = window.scrollY
      let foundId = ''

      for (let i = sections.length - 1; i >= 0; i--) {
        const section = sections[i]
        const sectionTop = section.getBoundingClientRect().top + scrollY
        if (sectionTop - (HEADER_OFFSET + 10) <= scrollY) {
          foundId = section.id
          break
        }
      }

      if (!foundId && sections.length > 0) {
        foundId = sections[0].id
      }

      if (foundId && foundId !== activeId) {
        activeId = foundId
        updateActiveLink()
      }
    }

    // Scroll suave e sem falhas para qualquer seletor ou ID numérico
    links.forEach(link => {
      link.addEventListener('click', e => {
        e.preventDefault()
        const href = link.getAttribute('href')
        if (!href) return

        const rawId = href.replace(/^#/, '')
        let decodedId = rawId
        try {
          decodedId = decodeURIComponent(rawId)
        } catch (_) {}

        // Busca resiliente por ID sem restrições de seletores CSS
        let target: HTMLElement | null =
          document.getElementById(decodedId) ||
          document.getElementById(rawId)

        if (!target) {
          try {
            target = document.querySelector(`[id="${CSS.escape(decodedId)}"]`) ||
                     document.querySelector(`[id="${CSS.escape(rawId)}"]`)
          } catch (_) {}
        }

        if (target) {
          const elementPosition = target.getBoundingClientRect().top
          const offsetPosition = elementPosition + window.pageYOffset - (HEADER_OFFSET - 20)

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          })

          activeId = target.id
          updateActiveLink()

          if (history.pushState) {
            history.pushState(null, '', `#${target.id}`)
          }
        }
      })
    })

    // Ativar posição inicial
    setTimeout(() => {
      findActiveHeading()
    }, 100)

    currentScrollHandler = () => {
      findActiveHeading()
    }

    window.addEventListener('scroll', currentScrollHandler, { passive: true })
  }

  document.addEventListener('astro:page-load', initializeToc)
</script>
