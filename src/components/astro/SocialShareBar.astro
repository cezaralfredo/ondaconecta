---
/**
 * Onda Conecta — Social Share Bar & Pinterest Pin Generator
 * Permite compartilhamento em um clique com destaque para o botão oficial "Salvar no Pinterest".
 */
interface Props {
  title: string
  description?: string
  media?: string
  url?: string
  lang?: 'pt' | 'en' | 'es' | string
}

const {
  title,
  description = '',
  media = '',
  url,
  lang = 'pt'
} = Astro.props

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://ondaconecta.com.br'
const postUrl = url || (new URL(Astro.url.pathname, Astro.site).toString())

const fullMediaUrl = media
  ? (media.startsWith('http') ? media : `${siteUrl}${media}`)
  : `${siteUrl}/images/og-image.png`

const isEn = lang === 'en'
const isEs = lang === 'es'

const shareLabel = isEn ? 'Share this article' : isEs ? 'Compartir artículo' : 'Compartilhe este artigo'
const pinLabel = isEn ? 'Save' : isEs ? 'Guardar' : 'Salvar'
const copyLabel = isEn ? 'Copy link' : isEs ? 'Copiar enlace' : 'Copiar link'
const copiedLabel = isEn ? 'Copied!' : isEs ? '¡Copiado!' : 'Copiado!'

const pinterestUrl = `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(postUrl)}&media=${encodeURIComponent(fullMediaUrl)}&description=${encodeURIComponent(title)}`
const whatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title} — ${postUrl}`)}`
const telegramUrl = `https://t.me/share/url?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(title)}`
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`
const twitterUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(postUrl)}`
---

<div class='not-prose my-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-border/60 bg-muted/30 px-4 py-3 sm:px-5'>
  <div class='flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground'>
    <svg class='size-4 text-primary' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z'></path>
    </svg>
    <span>{shareLabel}</span>
  </div>

  <div class='flex items-center gap-2'>
    <!-- Pinterest Button (High-Converting Rich Pin) -->
    <a
      href={pinterestUrl}
      target='_blank'
      rel='noopener noreferrer'
      title='Salvar no Pinterest'
      class='inline-flex items-center gap-1.5 rounded-lg bg-[#E60023] px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-[#c9001f] hover:scale-105 active:scale-95'
    >
      <svg class='size-3.5 fill-current' viewBox='0 0 24 24'>
        <path d='M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.627 0 12-5.372 12-11.992C24.017 5.367 18.644 0 12.017 0z'></path>
      </svg>
      <span>{pinLabel}</span>
    </a>

    <!-- WhatsApp Button -->
    <a
      href={whatsappUrl}
      target='_blank'
      rel='noopener noreferrer'
      title='Compartilhar no WhatsApp'
      class='inline-flex items-center justify-center rounded-lg border border-border/80 bg-background p-2 text-muted-foreground transition-all hover:border-[#25D366] hover:bg-[#25D366]/10 hover:text-[#25D366] active:scale-95'
    >
      <svg class='size-4 fill-current' viewBox='0 0 24 24'>
        <path d='M17.472 14.382c-.301-.15-1.782-.879-2.058-.979-.276-.1-.476-.15-.677.15-.201.3-.778.979-.953 1.179-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.896-.799-1.501-1.787-1.677-2.088-.176-.301-.019-.464.132-.614.135-.135.301-.351.452-.527.15-.176.201-.301.301-.502.101-.201.05-.377-.025-.527-.075-.15-.677-1.632-.928-2.235-.245-.588-.495-.508-.677-.518-.176-.009-.377-.011-.578-.011s-.527.075-.803.377c-.276.301-1.054 1.03-1.054 2.512s1.079 2.914 1.23 3.115c.15.201 2.124 3.243 5.145 4.549.719.311 1.28.497 1.718.636.723.23 1.381.198 1.901.12.58-.088 1.782-.728 2.033-1.431.251-.703.251-1.306.176-1.431-.076-.125-.276-.201-.577-.351zM12.004 21.996h-.002c-1.802 0-3.568-.485-5.114-1.402l-.367-.218-3.803.997 1.015-3.708-.239-.381a10.02 10.02 0 01-1.536-5.28c0-5.529 4.498-10.027 10.03-10.027 2.679 0 5.197 1.044 7.091 2.94 1.895 1.896 2.938 4.416 2.937 7.097 0 5.531-4.498 10.029-10.017 10.029zm8.513-18.537C18.243 1.185 15.239 0 12.004 0 5.372 0 .004 5.368.004 12c0 2.115.552 4.181 1.6 6.002L0 24l6.168-1.572c1.761.961 3.754 1.468 5.836 1.468h.005c6.63 0 12-5.369 12-12 0-3.208-1.25-6.223-3.492-8.437z'></path>
      </svg>
    </a>

    <!-- Telegram Button -->
    <a
      href={telegramUrl}
      target='_blank'
      rel='noopener noreferrer'
      title='Compartilhar no Telegram'
      class='inline-flex items-center justify-center rounded-lg border border-border/80 bg-background p-2 text-muted-foreground transition-all hover:border-[#229ED9] hover:bg-[#229ED9]/10 hover:text-[#229ED9] active:scale-95'
    >
      <svg class='size-4 fill-current' viewBox='0 0 24 24'>
        <path d='M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.121l-6.871 4.326-2.962-.924c-.643-.204-.657-.643.136-.953l11.57-4.458c.538-.196 1.006.128.832.949z'/>
      </svg>
    </a>

    <!-- LinkedIn Button -->
    <a
      href={linkedinUrl}
      target='_blank'
      rel='noopener noreferrer'
      title='Compartilhar no LinkedIn'
      class='inline-flex items-center justify-center rounded-lg border border-border/80 bg-background p-2 text-muted-foreground transition-all hover:border-[#0A66C2] hover:bg-[#0A66C2]/10 hover:text-[#0A66C2] active:scale-95'
    >
      <svg class='size-4 fill-current' viewBox='0 0 24 24'>
        <path d='M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z'></path>
      </svg>
    </a>

    <!-- Twitter / X Button -->
    <a
      href={twitterUrl}
      target='_blank'
      rel='noopener noreferrer'
      title='Compartilhar no X (Twitter)'
      class='inline-flex items-center justify-center rounded-lg border border-border/80 bg-background p-2 text-muted-foreground transition-all hover:border-foreground hover:bg-muted hover:text-foreground active:scale-95'
    >
      <svg class='size-3.5 fill-current' viewBox='0 0 24 24'>
        <path d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'></path>
      </svg>
    </a>

    <!-- Copy Link Button with Toast State -->
    <button
      type='button'
      id='copy-link-btn'
      data-url={postUrl}
      data-copied-label={copiedLabel}
      data-default-label={copyLabel}
      title={copyLabel}
      class='inline-flex items-center gap-1.5 rounded-lg border border-border/80 bg-background px-3 py-1.5 text-xs font-medium text-muted-foreground transition-all hover:bg-muted hover:text-foreground active:scale-95'
    >
      <svg id='copy-icon' class='size-3.5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1'></path>
      </svg>
      <span id='copy-text'>{copyLabel}</span>
    </button>
  </div>
</div>

<script is:inline>
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const targetUrl = copyBtn.getAttribute('data-url') || window.location.href;
      const copiedText = copyBtn.getAttribute('data-copied-label') || 'Copiado!';
      const defaultText = copyBtn.getAttribute('data-default-label') || 'Copiar link';
      const textSpan = document.getElementById('copy-text');

      try {
        await navigator.clipboard.writeText(targetUrl);
        if (textSpan) textSpan.textContent = copiedText;
        copyBtn.classList.add('border-emerald-500', 'text-emerald-500');
        setTimeout(() => {
          if (textSpan) textSpan.textContent = defaultText;
          copyBtn.classList.remove('border-emerald-500', 'text-emerald-500');
        }, 2000);
      } catch (err) {
        console.error('Falha ao copiar:', err);
      }
    });
  }
</script>
