---
/**
 * Onda Conecta — Bloco de Anúncio Google AdSense (Display Responsivo)
 * Renderiza anúncio oficial com colapso elegante quando não preenchido.
 */
interface Props {
  slot?: string
  client?: string
  className?: string
}

const {
  slot = '8355599715',
  client = 'ca-pub-4965740102250985',
  className = ''
} = Astro.props
---

<div class={`adsense-container not-prose my-6 flex w-full flex-col items-center justify-center overflow-hidden text-center ${className}`}>
  <!-- Onda Conecta - anúncio display horizontal -->
  <ins
    class='adsbygoogle block w-full text-center'
    style='display:block; width:100%; text-align:center;'
    data-ad-client={client}
    data-ad-slot={slot}
    data-ad-format='auto'
    data-full-width-responsive='true'
  ></ins>
</div>

<style>
  /* Evita caixas vazias ou espaços em branco antes da aprovação do Google AdSense */
  ins.adsbygoogle[data-ad-status='unfilled'] {
    display: none !important;
  }
  .adsense-container:has(ins[data-ad-status='unfilled']) {
    display: none !important;
  }
</style>

<script is:inline>
  function initAdSenseBanners() {
    try {
      var uninitializedAds = document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])');
      if (uninitializedAds.length > 0) {
        uninitializedAds.forEach(function() {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        });
      }
    } catch (e) {
      // Ignora silenciosamente
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdSenseBanners);
  } else {
    initAdSenseBanners();
  }

  document.addEventListener('astro:page-load', initAdSenseBanners);
</script>
