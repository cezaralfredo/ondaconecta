---
/**
 * Onda Conecta — Bloco de Anúncio Google AdSense (Display Horizontal 01)
 * Renderiza o anúncio oficial aprovado pelo Google AdSense com suporte responsivo.
 */
interface Props {
  slot?: string
  client?: string
  className?: string
}

const {
  slot = '8355599715',
  client = 'ca-pub-4965740102250985',
  className = ''
} = Astro.props
---

<div class={`not-prose my-8 flex w-full flex-col items-center justify-center overflow-hidden rounded-xl bg-muted/20 p-2 sm:p-4 text-center ${className}`}>
  <span class='mb-2 text-[10px] font-medium tracking-wider text-muted-foreground uppercase opacity-70'>
    Publicidade
  </span>

  <div class='w-full min-h-[90px] sm:min-h-[100px] flex justify-center items-center overflow-hidden'>
    <!-- Onda Conecta - anúncio display horizontal 01 -->
    <ins
      class='adsbygoogle block w-full'
      style='display:block; width:100%; min-height:90px;'
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format='auto'
      data-full-width-responsive='true'
    ></ins>
  </div>
</div>

<script is:inline>
  function initAdSenseBanners() {
    try {
      // Identifica apenas os blocos de anúncio que ainda não foram processados pelo Google
      var uninitializedAds = document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])');
      if (uninitializedAds.length > 0) {
        uninitializedAds.forEach(function() {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        });
      }
    } catch (e) {
      // Ignora avisos silenciosos se AdBlock estiver ativo ou bloqueio de scripts
    }
  }

  // Executa no primeiro carregamento
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdSenseBanners);
  } else {
    initAdSenseBanners();
  }

  // Compatibilidade com transições de página do Astro (ClientRouter)
  document.addEventListener('astro:page-load', initAdSenseBanners);
</script>
