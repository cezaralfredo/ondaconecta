---
interface Props {
  zoneId: string
  className?: string
}

const { zoneId, className = '' } = Astro.props
---

<div class={`ad-banner-container my-6 flex w-full justify-center overflow-hidden text-center ${className}`}>
  <div>
    <script is:inline type='text/javascript' define:vars={{ zoneId }}>
      if (typeof aclib !== 'undefined' && aclib.runBanner) {
        aclib.runBanner({
          zoneId: zoneId
        });
      } else {
        window.addEventListener('load', function() {
          if (typeof aclib !== 'undefined' && aclib.runBanner) {
            aclib.runBanner({
              zoneId: zoneId
            });
          }
        });
      }
    </script>
  </div>
</div>
