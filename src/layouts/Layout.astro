---
import '@/styles/global.css'

import { ClientRouter } from 'astro:transitions'

import HeadSeo from '@/layouts/HeadSeo.astro'
import PinterestTracker from '@/components/astro/PinterestTracker.astro'
import OneSignal from '@/components/astro/OneSignal.astro'
import Header from '@/components/layout/header'
import Footer from '@/components/layout/footer'
import CookieConsent from '@/components/astro/CookieConsent.astro'
import { PROJECT_CATEGORIES, getCategoryLabel } from '@/consts'

import type { NavigationSection } from '@/components/blocks/menu-navigation'

const isEn = Astro.currentLocale === 'en'
const isEs = Astro.currentLocale === 'es'
const localeCode: 'pt' | 'en' | 'es' = isEn ? 'en' : isEs ? 'es' : 'pt'

const categoryPrefix = isEn ? '/en/categories' : isEs ? '/es/categorias' : '/categorias'
const categoryParamPrefix = isEn ? '/en/categories?category=' : isEs ? '/es/categorias?category=' : '/categorias?category='

const categorySubmenu = [
  ...PROJECT_CATEGORIES.map(cat => ({
    title: getCategoryLabel(cat, localeCode),
    href: `${categoryParamPrefix}${encodeURIComponent(cat)}`
  })),
  { title: isEn ? '⚡ All Categories' : isEs ? '⚡ Todas las Categorías' : '⚡ Todas as Categorias', href: categoryPrefix }
]

const navigationData: NavigationSection[] = [
  {
    title: isEn ? 'Home' : isEs ? 'Inicio' : 'Início',
    href: isEn ? '/en' : isEs ? '/es' : '/'
  },
  {
    title: isEn ? 'AI Solutions' : isEs ? 'Soluciones IA' : 'Soluções de IA',
    href: '/servicos-ia'
  },
  {
    title: isEn ? 'About Us' : isEs ? 'Quiénes Somos' : 'Quem Somos',
    href: '/quem-somos'
  },
  {
    title: isEn ? 'Categories' : isEs ? 'Categorías' : 'Categorias',
    items: categorySubmenu
  },
  {
    title: isEn ? 'Useful Tools' : isEs ? 'Herramientas' : 'Ferramentas',
    href: isEn ? '/en/tools' : isEs ? '/es/herramientas' : '/ferramentas'
  },
  {
    title: isEn ? 'Contact' : isEs ? 'Contacto' : 'Contato',
    href: '/contato'
  }
]

interface Props {
  canonical?: string
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  keywords?: string
  author?: string
  publishedTime?: string
  modifiedTime?: string
  noindex?: boolean
  nofollow?: boolean
  schema?: Record<string, any>
  alternateLinks?: {
    pt?: string
    en?: string
    es?: string
    default?: string
  } | false
}

const seoProps = Astro.props as Props
const currentLang = Astro.currentLocale === 'en' ? 'en' : Astro.currentLocale === 'es' ? 'es' : 'pt-BR'
---

<!doctype html>
<html lang={currentLang} class='scroll-smooth'>
  <head>
    {/* Google Consent Mode v2 - Padrão restrito até aprovação do usuário (LGPD / GDPR) */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      // Default: denied para cookies de anúncios e personalização
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied'
      });
    </script>

    <HeadSeo {...seoProps} />

    <PinterestTracker />
    <OneSignal />
    <ClientRouter />
    <script is:inline>
      ;(function () {
        const getTheme = () => {
          if (typeof localStorage !== 'undefined') {
            const stored = localStorage.getItem('theme')
            if (stored === 'light' || stored === 'dark') {
              return stored
            }
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }

        const applyTheme = () => {
          const theme = getTheme()
          if (theme === 'dark') {
            document.documentElement.classList.add('dark')
          } else {
            document.documentElement.classList.remove('dark')
          }
        }

        // Apply theme immediately on initial load
        applyTheme()

        // Re-apply theme on Astro page transitions
        document.addEventListener('astro:page-load', applyTheme)

        // Auto-cura de cache 301 legado de /categorias -> /es/categorias nos navegadores dos leitores
        try {
          const path = window.location.pathname.replace(/\/$/, '')
          const search = window.location.search || ''

          // 1. Se o navegador caiu em /es/categorias vindo de uma página em Português (por cache 301 antigo),
          // revalida /categorias direto no servidor (cache: 'reload') e redireciona imediatamente para a página PT-BR
          if (path === '/es/categorias' && document.referrer) {
            const refUrl = new URL(document.referrer)
            const refPath = refUrl.pathname.replace(/\/$/, '')
            const cameFromPtPage =
              refUrl.origin === window.location.origin &&
              !refPath.startsWith('/es') &&
              !refPath.startsWith('/en') &&
              refPath !== '/categorias'

            if (cameFromPtPage && !sessionStorage.getItem('onda_pt_cat_recovered')) {
              sessionStorage.setItem('onda_pt_cat_recovered', '1')
              const targetPt = '/categorias' + search
              fetch(targetPt, { cache: 'reload' })
                .catch(function () {})
                .finally(function () {
                  window.location.replace(targetPt)
                })
              return
            }
          } else {
            sessionStorage.removeItem('onda_pt_cat_recovered')
          }

          // 2. Invalida silenciosamente em background qualquer 301 antigo de /categorias no cache HTTP do navegador
          if (localStorage.getItem('onda_pt_cat_cache_v2') !== '1') {
            localStorage.setItem('onda_pt_cat_cache_v2', '1')
            fetch('/categorias', { cache: 'reload' }).catch(function () {})
          }
        } catch (e) {}
      })()
    </script>
    <style>
      /* Disable all view transitions while keeping client-side navigation */
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation-duration: 0ms !important;
      }
    </style>
  </head>
  <body class='flex min-h-full w-full flex-auto flex-col'>
    <div class='flex flex-col'>
      {/* Header Section */}
      <Header navigationData={navigationData} lang={localeCode} client:load />

      <main class='flex flex-col *:scroll-mt-15.5'><slot /></main>

      {/* Footer Section */}
      <Footer lang={localeCode} client:load />
    </div>

    {/* Cookie Consent Banner (LGPD / GDPR / Google Consent Mode v2) */}
    <CookieConsent />
  </body>
</html>
