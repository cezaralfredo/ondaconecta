---
import '@/styles/global.css'

import { ClientRouter } from 'astro:transitions'

import HeadSeo from '@/layouts/HeadSeo.astro'
import Header from '@/components/layout/header'
import Footer from '@/components/layout/footer'

import type { NavigationSection } from '@/components/blocks/menu-navigation'

const isEn = Astro.currentLocale === 'en'
const isEs = Astro.currentLocale === 'es'

const categoryPrefix = isEn ? '/en#categories' : isEs ? '/es#categories' : '/#categories'
const categoryParamPrefix = isEn ? '/en?category=' : isEs ? '/es?category=' : '/?category='

const categorySubmenu = [
  { title: isEn ? 'Inovação & IA' : isEs ? 'Innovación e IA' : 'Inovação & IA', href: `${categoryParamPrefix}${encodeURIComponent('Inovação & IA')}#categories` },
  { title: isEn ? 'Mercado & Negócios' : isEs ? 'Mercados y Negocios' : 'Mercado & Negócios', href: `${categoryParamPrefix}${encodeURIComponent('Mercado & Negócios')}#categories` },
  { title: isEn ? 'Finanças Pessoais' : isEs ? 'Finanzas Personales' : 'Finanças Pessoais', href: `${categoryParamPrefix}${encodeURIComponent('Finanças Pessoais')}#categories` },
  { title: isEn ? 'Saúde & Bem-estar' : isEs ? 'Salud y Bienestar' : 'Saúde & Bem-estar', href: `${categoryParamPrefix}${encodeURIComponent('Saúde & Bem-estar')}#categories` },
  { title: isEn ? 'Estética & Beleza' : isEs ? 'Estética y Belleza' : 'Estética & Beleza', href: `${categoryParamPrefix}${encodeURIComponent('Estética & Beleza')}#categories` },
  { title: isEn ? 'Estilo de Vida & Viagens' : isEs ? 'Estilo de Vida y Viajes' : 'Estilo de Vida & Viagens', href: `${categoryParamPrefix}${encodeURIComponent('Estilo de Vida & Viagens')}#categories` },
  { title: isEn ? 'Tendências' : isEs ? 'Tendencias' : 'Tendências', href: `${categoryParamPrefix}${encodeURIComponent('Tendências')}#categories` },
  { title: isEn ? 'Sustentabilidade' : isEs ? 'Sostenibilidad' : 'Sustentabilidade', href: `${categoryParamPrefix}${encodeURIComponent('Sustentabilidade')}#categories` },
  { title: isEn ? 'Comportamento' : isEs ? 'Comportamiento' : 'Comportamento', href: `${categoryParamPrefix}${encodeURIComponent('Comportamento')}#categories` },
  { title: isEn ? '⚡ Todas as Categorias' : isEs ? '⚡ Todas las Categorías' : '⚡ Todas as Categorias', href: categoryPrefix }
]

const navigationData: NavigationSection[] = [
  {
    title: isEn ? 'Home' : isEs ? 'Inicio' : 'Início',
    href: isEn ? '/en' : isEs ? '/es' : '/'
  },
  {
    title: isEn ? 'About Us' : isEs ? 'Quiénes Somos' : 'Quem Somos',
    href: '/quem-somos'
  },
  {
    title: isEn ? 'Categories' : isEs ? 'Categorías' : 'Categorias',
    items: categorySubmenu
  },
  {
    title: isEn ? 'Useful Tools' : isEs ? 'Herramientas' : 'Ferramentas',
    href: isEn ? '/en/tools' : isEs ? '/es/herramientas' : '/ferramentas'
  },
  {
    title: isEn ? 'Contact' : isEs ? 'Contacto' : 'Contato',
    href: '/contato'
  }
]

interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  keywords?: string
  author?: string
  publishedTime?: string
  modifiedTime?: string
  noindex?: boolean
  nofollow?: boolean
  schema?: Record<string, any>
}

const seoProps = Astro.props as Props
const currentLang = Astro.currentLocale === 'en' ? 'en' : Astro.currentLocale === 'es' ? 'es' : 'pt-BR'
---

<!doctype html>
<html lang={currentLang} class='scroll-smooth'>
  <head>
    <HeadSeo {...seoProps} />
    <ClientRouter />
    <script is:inline>
      ;(function () {
        const getTheme = () => {
          if (typeof localStorage !== 'undefined') {
            const stored = localStorage.getItem('theme')
            if (stored === 'light' || stored === 'dark') {
              return stored
            }
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }

        const applyTheme = () => {
          const theme = getTheme()
          if (theme === 'dark') {
            document.documentElement.classList.add('dark')
          } else {
            document.documentElement.classList.remove('dark')
          }
        }

        // Apply theme immediately on initial load
        applyTheme()

        // Re-apply theme on Astro page transitions
        document.addEventListener('astro:page-load', applyTheme)
      })()
    </script>
    <style>
      /* Disable all view transitions while keeping client-side navigation */
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation-duration: 0ms !important;
      }
    </style>
  </head>
  <body class='flex min-h-full w-full flex-auto flex-col'>
    <div class='flex flex-col'>
      {/* Header Section */}
      <Header navigationData={navigationData} client:load />

      <main class='flex flex-col *:scroll-mt-15.5'><slot /></main>

      {/* Footer Section */}
      <Footer client:load />
    </div>
  </body>
</html>
