---
import Layout from '@/layouts/Layout.astro'
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from '@/components/ui/breadcrumb'

const pageTitle = 'Serviços de Inteligência Artificial & Automação Inteligente | Onda Conecta'
const pageDescription = 'RIA360 (Recepcionista de Inteligência Artificial 360°), agentes de IA autônomos, atendimento e agendamento via WhatsApp com PIX, Twenty CRM e automações n8n.'
const pageKeywords = 'ria360, recepcionista de inteligencia artificial 360 graus, inteligencia artificial para empresas, agentes autonomos de ia, agendamento whatsapp pix, twenty crm, hermes agent, automacao n8n, anaue design, onda conecta'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Serviços de Inteligência Artificial e Automação Corporativa',
  provider: {
    '@type': 'Organization',
    name: 'Onda Conecta & Anauê Design',
    url: 'https://ondaconecta.com.br',
    telephone: '+55-85-99627-7707',
    email: 'contato@anauedesign.com.br',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Rua Firmo Ananias Cardoso, 622',
      addressLocality: 'Sapiranga, Fortaleza',
      addressRegion: 'CE',
      postalCode: '60833-432',
      addressCountry: 'BR'
    }
  },
  description: pageDescription,
  url: 'https://ondaconecta.com.br/servicos-ia',
  serviceType: 'Engenharia de Software, Inteligência Artificial e Automação de Processos',
  areaServed: 'BR'
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <!-- Breadcrumbs -->
  <div class='border-b bg-muted/20 py-3.5'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href='/'>Início</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>Soluções em Inteligência Artificial</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </div>
  </div>

  <!-- HERO SECTION -->
  <section class='relative min-h-[85vh] flex items-center justify-center overflow-hidden py-20 lg:py-28 bg-slate-950 text-white'>
    <!-- Imagem de fundo com overlay cinematográfico -->
    <div class='absolute inset-0 z-0'>
      <img
        src='/images/servicos/hero-ia-bg.webp'
        alt='Infraestrutura de inteligência artificial corporativa e agentes autônomos'
        class='w-full h-full object-cover object-center opacity-30 transform scale-105 transition-transform duration-1000'
        loading='eager'
      />
      <div class='absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent'></div>
      <div class='absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(14,165,233,0.25),rgba(255,255,255,0))]'></div>
    </div>

    <div class='relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center space-y-8'>
      <!-- Pill Badge -->
      <div class='inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/10 backdrop-blur-md px-4 py-1.5 text-xs sm:text-sm font-semibold text-cyan-300 shadow-[0_0_20px_rgba(6,182,212,0.15)]'>
        <span class='inline-block w-2 h-2 rounded-full bg-cyan-400 animate-pulse'></span>
        Engenharia de IA & Automação Inteligente de Processos
      </div>

      <!-- Título Principal Impactante -->
      <h1 class='text-4xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl text-balance leading-[1.1]'>
        Transforme Processos Manuais em <br class='hidden sm:inline' />
        <span class='bg-gradient-to-r from-cyan-400 via-teal-300 to-indigo-400 bg-clip-text text-transparent'>
          Operações Autônomas de Alta Escala
        </span>
      </h1>

      <!-- Subtítulo Persuasivo -->
      <p class='text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed text-balance'>
        Construímos ecossistemas práticos e seguros de Inteligência Artificial sob medida para sua empresa: agentes autônomos com raciocínio multi-etapas, atendimento e agendamento 24/7 no WhatsApp com pagamentos integrados, CRM moderno e fluxos que eliminam tarefas repetitivas.
      </p>

      <!-- CTAs de Ação -->
      <div class='flex flex-col sm:flex-row items-center justify-center gap-4 pt-4'>
        <a
          href='https://wa.me/5585996277707?text=Ol%C3%A1%2C%20gostaria%20de%20um%20diagn%C3%B3stico%20gratuito%20sobre%20as%20solu%C3%A7%C3%B5es%20de%20IA%20e%20automa%C3%A7%C3%A3o%20para%20minha%20empresa.'
          target='_blank'
          rel='noopener noreferrer'
          class='w-full sm:w-auto inline-flex items-center justify-center gap-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 px-8 py-4 text-base font-bold text-white shadow-lg shadow-cyan-500/25 hover:from-cyan-400 hover:to-blue-500 transition-all hover:scale-[1.02] active:scale-[0.98]'
        >
          <svg class='w-5 h-5 fill-current' viewBox='0 0 24 24'>
            <path d='M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.791.82 3.183 0 5.769-2.586 5.769-5.766.001-3.182-2.585-5.806-5.77-5.806zm8.136 5.767c0 4.498-3.659 8.157-8.157 8.157-1.42 0-2.75-.36-3.92-1l-4.47 1.17 1.19-4.36c-.72-1.23-1.12-2.65-1.12-4.14 0-4.498 3.659-8.157 8.157-8.157s8.32 3.829 8.32 8.33z' />
          </svg>
          Solicitar Diagnóstico no WhatsApp
        </a>

        <a
          href='#solucoes-principais'
          class='w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-900/60 backdrop-blur-md px-8 py-4 text-base font-semibold text-slate-200 hover:bg-slate-800/80 hover:text-white transition-all'
        >
          Explorar Nossas Soluções
          <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7' />
          </svg>
        </a>
      </div>

      <!-- Barra de Métricas & Indicadores -->
      <div class='pt-12 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 border-t border-slate-800/80 max-w-4xl mx-auto text-left'>
        <div class='bg-slate-900/40 border border-slate-800 rounded-2xl p-4'>
          <div class='text-2xl sm:text-3xl font-extrabold text-cyan-400'>+90%</div>
          <div class='text-xs sm:text-sm text-slate-400 mt-1'>Redução de tarefas manuais repetitivas</div>
        </div>
        <div class='bg-slate-900/40 border border-slate-800 rounded-2xl p-4'>
          <div class='text-2xl sm:text-3xl font-extrabold text-teal-400'>24/7</div>
          <div class='text-xs sm:text-sm text-slate-400 mt-1'>Atendimento sem fila nem interrupções</div>
        </div>
        <div class='bg-slate-900/40 border border-slate-800 rounded-2xl p-4'>
          <div class='text-2xl sm:text-3xl font-extrabold text-indigo-400'>&lt;100ms</div>
          <div class='text-xs sm:text-sm text-slate-400 mt-1'>Respostas instantâneas e sem atrito</div>
        </div>
        <div class='bg-slate-900/40 border border-slate-800 rounded-2xl p-4'>
          <div class='text-2xl sm:text-3xl font-extrabold text-emerald-400'>100%</div>
          <div class='text-xs sm:text-sm text-slate-400 mt-1'>Conformidade LGPD e dados isolados</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ÂNCORA DE SOLUÇÕES -->
  <div id='solucoes-principais' class='scroll-mt-10'></div>

  <!-- SEÇÃO 1: RIA360 (RECEPCIONISTA DE INTELIGÊNCIA ARTIFICIAL 360 GRAUS) -->
  <section class='py-20 lg:py-28 bg-background border-b'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-20'>
      <!-- Header da Seção -->
      <div class='max-w-3xl space-y-4'>
        <div class='inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-semibold text-emerald-600 dark:text-emerald-400'>
          ✦ RIA360 · Recepcionista de Inteligência Artificial 360°
        </div>
        <h2 class='text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-foreground'>
          RIA360: Uma Recepcionista com IA <br />
          <span class='bg-gradient-to-r from-emerald-600 via-teal-500 to-cyan-500 bg-clip-text text-transparent'>
            que Atende no WhatsApp até às 23h
          </span>
        </h2>
        <p class='text-base sm:text-lg text-muted-foreground leading-relaxed'>
          Feita para <strong>salões de beleza, barbearias, clínicas de estética e negócios que vivem de agenda cheia</strong>. Seu agente de IA conversa naturalmente com a cliente, escolhe o profissional, marca o horário, cobra o sinal por PIX e lembra antes do atendimento. Tudo sincronizado no seu painel administrativo.
        </p>
      </div>

      <!-- SHOWCASE SIDE-BY-SIDE: MOCKUP DO PAINEL + SIMULAÇÃO DO WHATSAPP -->
      <div class='grid grid-cols-1 lg:grid-cols-12 gap-10 items-center'>
        <!-- Coluna da Esquerda: Mockup do Painel Web -->
        <div class='lg:col-span-6 relative group'>
          <div class='absolute -inset-1 rounded-3xl bg-gradient-to-r from-emerald-500 to-cyan-500 opacity-20 blur-xl group-hover:opacity-30 transition duration-500'></div>
          <div class='relative overflow-hidden rounded-2xl border bg-card shadow-2xl'>
            <img
              src='/images/servicos/atende-agenda-mockup.webp'
              alt='Interface do Painel Administrativo do RIA360 com controle de equipe, agendas e cobranças'
              class='w-full h-auto object-cover transform group-hover:scale-[1.01] transition-transform duration-500'
              loading='lazy'
            />
            <div class='p-4 bg-muted/40 border-t flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground'>
              <span class='font-medium text-foreground flex items-center gap-1.5'>
                <span class='w-2 h-2 rounded-full bg-emerald-500 animate-pulse'></span>
                Painel Administrativo RIA360
              </span>
              <span>Agenda por Profissional · PIX Direto</span>
            </div>
          </div>
        </div>

        <!-- Coluna da Direita: Simulação da Conversa no WhatsApp (22h14) -->
        <div class='lg:col-span-6'>
          <div class='rounded-3xl border border-emerald-500/30 bg-slate-950 p-4 sm:p-6 shadow-2xl text-slate-100 max-w-lg mx-auto lg:max-w-none'>
            <!-- Topo do WhatsApp -->
            <div class='flex items-center justify-between border-b border-slate-800 pb-4 mb-4'>
              <div class='flex items-center gap-3'>
                <div class='relative w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center text-white font-bold text-sm shadow-md'>
                  🤖
                  <span class='absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-400 border-2 border-slate-950'></span>
                </div>
                <div>
                  <div class='font-bold text-sm text-white flex items-center gap-1.5'>
                    Recepcionista IA · RIA360
                    <span class='text-[10px] bg-emerald-500/20 text-emerald-400 px-1.5 py-0.2 rounded font-medium'>Oficial</span>
                  </div>
                  <div class='text-xs text-slate-400'>Online agora · Responde em 3 segundos</div>
                </div>
              </div>
              <div class='text-xs text-slate-500 font-mono'>WhatsApp · 22h14</div>
            </div>

            <!-- Balões de Diálogo Reais -->
            <div class='space-y-3.5 text-xs sm:text-sm'>
              <!-- Mensagem da Cliente -->
              <div class='flex justify-end'>
                <div class='bg-emerald-800/80 text-white rounded-2xl rounded-tr-none px-4 py-2.5 max-w-[85%] shadow-sm'>
                  <p>Oi! Tem horário pra escova no sábado?</p>
                  <span class='block text-[10px] text-emerald-300/80 text-right mt-1'>22:14</span>
                </div>
              </div>

              <!-- Resposta da IA -->
              <div class='flex justify-start'>
                <div class='bg-slate-900 border border-slate-800 text-slate-200 rounded-2xl rounded-tl-none px-4 py-2.5 max-w-[90%] shadow-sm space-y-1'>
                  <p>Oi, Camila! Tenho sábado às <strong>10h com a Rafa</strong> e às <strong>14h com a Duda</strong>. Qual prefere?</p>
                  <span class='block text-[10px] text-slate-500 mt-1'>22:14</span>
                </div>
              </div>

              <!-- Escolha da Cliente -->
              <div class='flex justify-end'>
                <div class='bg-emerald-800/80 text-white rounded-2xl rounded-tr-none px-4 py-2.5 max-w-[85%] shadow-sm'>
                  <p>10h com a Rafa!</p>
                  <span class='block text-[10px] text-emerald-300/80 text-right mt-1'>22:15</span>
                </div>
              </div>

              <!-- Cobrança do Sinal por PIX -->
              <div class='flex justify-start'>
                <div class='bg-slate-900 border border-slate-800 text-slate-200 rounded-2xl rounded-tl-none px-4 py-2.5 max-w-[92%] shadow-sm space-y-1.5'>
                  <p>Perfeito! Para confirmar seu horário com a Rafa, envio o <strong>PIX do sinal de R$ 30,00</strong>. Assim que compensar, seu horário fica reservado automaticamente na agenda.</p>
                  <div class='p-2 rounded bg-slate-950 border border-emerald-500/30 text-[11px] font-mono text-emerald-400'>
                    🔑 Copia e Cola: 00020126580014br.gov.bcb.pix...
                  </div>
                  <span class='block text-[10px] text-slate-500'>22:15</span>
                </div>
              </div>

              <!-- Confirmação Instantânea -->
              <div class='flex justify-start'>
                <div class='bg-emerald-950/60 border border-emerald-500/40 text-emerald-200 rounded-2xl rounded-tl-none px-4 py-2.5 max-w-[92%] shadow-sm space-y-1'>
                  <p class='font-semibold text-emerald-300 flex items-center gap-1.5'>
                    <span>✅</span> Pagamento recebido com sucesso!
                  </p>
                  <p>Escova com a Rafa agendada para <strong>sábado às 10h</strong>. Te aviso por aqui um dia antes com o lembrete!</p>
                  <span class='block text-[10px] text-emerald-400/70'>22:16</span>
                </div>
              </div>
            </div>

            <!-- Rodapé do Card -->
            <div class='mt-4 pt-3 border-t border-slate-800/80 text-center text-[11px] text-slate-400'>
              Plataforma individual, com o tom de voz e as regras do seu salão ou clínica.
            </div>
          </div>
        </div>
      </div>

      <!-- BLOCO: O PROBLEMA (POR QUE SEU ESTABELECIMENTO ESTÁ PERDENDO DINHEIRO) -->
      <div class='rounded-3xl border border-rose-500/20 bg-gradient-to-b from-rose-500/5 via-background to-background p-6 sm:p-10 lg:p-12 space-y-10'>
        <div class='max-w-3xl space-y-3'>
          <div class='text-xs font-bold uppercase tracking-wider text-rose-500'>O Problema Que Ninguém Te Conta</div>
          <h3 class='text-2xl sm:text-3xl lg:text-4xl font-extrabold text-foreground'>
            Cada mensagem sem resposta é um horário que vai para o seu concorrente.
          </h3>
          <p class='text-base text-muted-foreground leading-relaxed'>
            A recepção para quando a equipe está atendendo. O WhatsApp dos seus clientes não para.
          </p>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
          <!-- Card Dor 1 -->
          <div class='rounded-2xl border bg-card p-6 space-y-3 shadow-sm'>
            <div class='text-2xl'>🌙</div>
            <h4 class='text-lg font-bold text-foreground'>Mensagens à Noite e no Domingo</h4>
            <p class='text-sm text-muted-foreground leading-relaxed'>
              É exatamente quando a cliente para, deita na cama e decide marcar seu horário. Se ninguém responde na hora, ela abre o WhatsApp de outro salão ou clínica e marca lá.
            </p>
          </div>

          <!-- Card Dor 2 -->
          <div class='rounded-2xl border bg-card p-6 space-y-3 shadow-sm'>
            <div class='text-2xl'>🚫</div>
            <h4 class='text-lg font-bold text-foreground'>Faltas e Horários Vazios (No-Show)</h4>
            <p class='text-sm text-muted-foreground leading-relaxed'>
              Sem lembrete automático e sem cobrança prévia de sinal, a cliente simplesmente esquece ou desmarca de última hora. Sua cadeira e seu profissional ficam parados dando prejuízo.
            </p>
          </div>

          <!-- Card Dor 3 -->
          <div class='rounded-2xl border bg-card p-6 space-y-3 shadow-sm'>
            <div class='text-2xl'>📱</div>
            <h4 class='text-lg font-bold text-foreground'>Equipe Presa no Celular</h4>
            <p class='text-sm text-muted-foreground leading-relaxed'>
              Quem deveria estar atendendo clientes e executando serviços passa o dia digitando respostas picadas no celular entre um atendimento e outro, prejudicando a qualidade do serviço.
            </p>
          </div>
        </div>

        <!-- A CONTA SIMPLES DA PERDA (EXTRAÍDO DO PDF) -->
        <div class='rounded-2xl border border-rose-500/30 bg-slate-950 text-white p-6 sm:p-8 flex flex-col lg:flex-row items-center justify-between gap-6 shadow-xl'>
          <div class='space-y-2 text-center lg:text-left'>
            <div class='text-xs font-bold text-rose-400 uppercase tracking-wider'>A Conta Simples (Exemplo Ilustrativo)</div>
            <div class='text-sm sm:text-base text-slate-300 font-mono'>
              agendamentos por mês × % de faltas × ticket médio = <strong class='text-white'>quanto você perde por mês</strong>
            </div>
            <p class='text-xs text-slate-400'>
              Um salão ou clínica comum com 15% de faltas e ticket de R$ 80 perde mais de R$ 40 mil por ano em cadeiras desocupadas.
            </p>
          </div>

          <div class='bg-rose-950/60 border border-rose-500/40 rounded-xl px-6 py-4 text-center shrink-0'>
            <div class='text-xs text-rose-300 uppercase font-semibold'>Prejuízo Mensal Evitável</div>
            <div class='text-2xl sm:text-3xl font-black text-rose-400 mt-1 font-mono'>
              300 × 15% × R$ 80 = <span class='text-white'>R$ 3.600</span>
            </div>
            <div class='text-[11px] text-slate-300 mt-1'>A RIA360 recupera esse valor no 1º mês</div>
          </div>
        </div>
      </div>

      <!-- BLOCO: COMO FUNCIONA (FLUXO EM 4 PASSOS) -->
      <div class='space-y-10'>
        <div class='text-center max-w-2xl mx-auto space-y-3'>
          <div class='text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400'>Fluxo 100% Autônomo</div>
          <h3 class='text-2xl sm:text-3xl lg:text-4xl font-extrabold text-foreground'>
            Da primeira mensagem ao horário confirmado, sem ninguém da equipe.
          </h3>
        </div>

        <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6'>
          <!-- Passo 1 -->
          <div class='relative rounded-2xl border bg-card p-6 space-y-4 hover:border-emerald-500/40 transition-colors shadow-sm'>
            <div class='w-10 h-10 rounded-full bg-emerald-500 text-white font-extrabold flex items-center justify-center text-sm shadow-md'>
              1
            </div>
            <h4 class='text-base font-bold text-foreground'>A Cliente Chama</h4>
            <p class='text-xs sm:text-sm text-muted-foreground leading-relaxed'>
              Pelo WhatsApp oficial do seu estabelecimento, a qualquer hora do dia ou da noite, inclusive finais de semana.
            </p>
          </div>

          <!-- Passo 2 -->
          <div class='relative rounded-2xl border bg-card p-6 space-y-4 hover:border-emerald-500/40 transition-colors shadow-sm'>
            <div class='w-10 h-10 rounded-full bg-teal-500 text-white font-extrabold flex items-center justify-center text-sm shadow-md'>
              2
            </div>
            <h4 class='text-base font-bold text-foreground'>A RIA360 Atende</h4>
            <p class='text-xs sm:text-sm text-muted-foreground leading-relaxed'>
              Entende o serviço desejado, consulta os horários livres na agenda e deixa a cliente escolher o profissional favorito.
            </p>
          </div>

          <!-- Passo 3 -->
          <div class='relative rounded-2xl border bg-card p-6 space-y-4 hover:border-emerald-500/40 transition-colors shadow-sm'>
            <div class='w-10 h-10 rounded-full bg-cyan-500 text-white font-extrabold flex items-center justify-center text-sm shadow-md'>
              3
            </div>
            <h4 class='text-base font-bold text-foreground'>O Sinal Confirma</h4>
            <p class='text-xs sm:text-sm text-muted-foreground leading-relaxed'>
              Gera a chave PIX ou link de cartão na conversa. O horário só trava na agenda quando o pagamento cai na sua conta.
            </p>
          </div>

          <!-- Passo 4 -->
          <div class='relative rounded-2xl border bg-card p-6 space-y-4 hover:border-emerald-500/40 transition-colors shadow-sm'>
            <div class='w-10 h-10 rounded-full bg-indigo-500 text-white font-extrabold flex items-center justify-center text-sm shadow-md'>
              4
            </div>
            <h4 class='text-base font-bold text-foreground'>Você Acompanha</h4>
            <p class='text-xs sm:text-sm text-muted-foreground leading-relaxed'>
              Agenda, equipe, clientes e valores atualizados instantaneamente no seu painel administrativo web.
            </p>
          </div>
        </div>
      </div>

      <!-- BLOCO: O QUE VOCÊ LEVA (OS 6 PILARES DE GESTÃO) -->
      <div class='space-y-10'>
        <div class='max-w-2xl space-y-3'>
          <div class='text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400'>O Que Você Leva</div>
          <h3 class='text-2xl sm:text-3xl lg:text-4xl font-extrabold text-foreground'>
            Atendimento, agenda, pagamento e gestão em um só lugar.
          </h3>
        </div>

        <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6'>
          <div class='rounded-2xl border bg-card p-6 space-y-3 shadow-sm hover:border-emerald-500/40 transition-all'>
            <div class='text-2xl'>👥</div>
            <h4 class='text-lg font-bold text-foreground'>Agenda por Profissional</h4>
            <p class='text-xs sm:text-sm text-muted-foreground leading-relaxed'>
              Cada profissional com seus serviços, horários de atendimento e duração específica. Zero conflito de horários.
            </p>
