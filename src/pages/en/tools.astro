---
import Layout from '@/layouts/Layout.astro'
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from '@/components/ui/breadcrumb'
import ToolsHub from '@/components/blocks/tools-hub/tools-hub'

const pageTitle = 'Useful Tools | Onda Conecta'
const pageDescription = 'Free browser utilities including compound interest calculator, instant QR Code generator, word counter, and top AI productivity tools directory.'
const pageKeywords = 'online tools, compound interest calculator, qr code generator, word counter, ai tools directory, productivity utilities, onda conecta'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Useful Tools | Onda Conecta',
  description: pageDescription,
  url: 'https://ondaconecta.com.br/en/tools'
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <div class='border-b bg-muted/20 py-4'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href='/en'>Home</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>Useful Tools</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </div>
  </div>

  <main>
    <ToolsHub client:load lang='en' />
  </main>
</Layout>
