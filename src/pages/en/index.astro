---
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

import HeroSection from '@/components/blocks/hero-section/hero-section'
import RecentPosts from '@/components/blocks/recent-posts/recent-posts'
import Blog from '@/components/blocks/blog-component/blog-component'
import AdBanner from '@/components/ads/AdBanner.astro'

// Get all posts for English (or fallback to all if en posts are still being populated)
const allPosts = await getCollection('blog')
const enPosts = allPosts.filter(p => p.data.lang === 'en')
const postsToShow = enPosts.length > 0 ? enPosts : allPosts

const allBlogPosts = postsToShow
  .map((post, index) => ({
    id: post.data.id || index + 1,
    slug: post.data.slug || post.id,
    title: post.data.title,
    description: post.data.description,
    imageUrl: post.data.imageUrl || '/images/blog-post/post-1.webp',
    imageAlt: post.data.imageAlt || post.data.title,
    pubDate: post.data.pubDate,
    category: post.data.category,
    author: post.data.author,
    avatarUrl: post.data.avatarUrl || '/images/avatars/post-1.webp',
    readTime: post.data.readTime || 5,
    featured: post.data.featured || false
  }))
  .sort((a, b) => b.id - a.id)

const pageTitle = 'Global Trends, Breaking News & Market Innovations'
const pageDescription =
  'Stay updated with global trends, breaking news, technological advancements, and insights shaping markets and industries worldwide.'
const pageKeywords =
  'global trends, tech innovation, future markets, artificial intelligence, sustainability, business trends, onda conecta'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: 'Onda Conecta',
  description: pageDescription,
  url: 'https://ondaconecta.com.br/en',
  publishingPrinciples: 'https://ondaconecta.com.br/about'
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  {/* Banner Top (12170634) */}
  <div class='mx-auto max-w-7xl px-4 pt-4 sm:px-6 lg:px-8'>
    <AdBanner zoneId='12170634' />
  </div>

  <HeroSection
    title={pageTitle}
    subtitle={pageDescription}
    badgeText='Global Trends & Market Intelligence'
    blogData={allBlogPosts}
    client:load
  />

  {/* Latest Updates Section (4 latest posts) */}
  <RecentPosts blogData={allBlogPosts} lang='en' client:load />

  {/* Banner Middle (12170662) */}
  <div class='mx-auto max-w-7xl px-4 py-2 sm:px-6 lg:px-8'>
    <AdBanner zoneId='12170662' />
  </div>

  <Blog blogData={allBlogPosts} lang='en' client:load />

  {/* Banner Bottom (12170662) */}
  <div class='mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8'>
    <AdBanner zoneId='12170662' />
  </div>
</Layout>
