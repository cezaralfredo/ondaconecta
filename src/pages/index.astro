---
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

import HeroSection from '@/components/blocks/hero-section/hero-section'
import RecentPosts from '@/components/blocks/recent-posts/recent-posts'
import Blog from '@/components/blocks/blog-component/blog-component'

// Get all blog posts and convert to the format expected by components
const allPosts = await getCollection('blog')
// Exibe na home principal apenas os posts em português (ou posts sem idioma definido por retrocompatibilidade)
const publishedPosts = allPosts.filter(p => !p.data.lang || p.data.lang === 'pt')


// Convert to the format expected by the React components
const allBlogPosts = publishedPosts
  .map((post, index) => ({
    id: post.data.id || index + 1,
    slug: post.data.slug || post.id,
    title: post.data.title,
    description: post.data.description,
    imageUrl: post.data.imageUrl || '/images/blog-post/post-1.webp',
    imageAlt: post.data.imageAlt || post.data.title,
    pubDate: post.data.pubDate,
    category: post.data.category,
    author: post.data.author,
    avatarUrl: post.data.avatarUrl || '/images/avatars/post-1.webp',
    readTime: post.data.readTime || 5,
    featured: post.data.featured || false
  }))
  .sort((a, b) => b.id - a.id)

// Page-specific SEO configuration
const pageTitle = 'Tendências, atualidades, zoom e buzz! | Onda Conecta'
const pageDescription =
  'Seu filtro de leitura: artigos aprofundados, notícias verificadas e análises rigorosas sobre tecnologia, negócios, inovação e futuro.'
const pageKeywords =
  'notícias de tendências, inovação, mercado futuro, inteligência artificial, sustentabilidade, negócios, tecnologia, onda conecta'

// Structured data for better SEO (NewsMediaOrganization / WebSite)
const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: 'Onda Conecta',
  description: pageDescription,
  url: 'https://ondaconecta.com.br',
  publishingPrinciples: 'https://ondaconecta.com.br/sobre'
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  {/* Hero Header */}
  <HeroSection client:load />

  {/* LOGO ABAIXO DA HERO: Seção Últimas Atualizações (4 últimos artigos) */}
  <RecentPosts blogData={allBlogPosts} client:load />

  {/* Seção Todas as Publicações: Exploração Completa por Categoria e Tendência */}
  <Blog blogData={allBlogPosts} client:load />
</Layout>
