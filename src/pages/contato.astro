---
import Layout from '@/layouts/Layout.astro'
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from '@/components/ui/breadcrumb'

const pageTitle = 'Contato | Fale com a Redação Onda Conecta & Anauê Design'
const pageDescription = 'Entre em contato com a equipe do Onda Conecta e Anauê Design. Sugestões de pautas, dúvidas, anúncios ou parcerias estratégicas.'
const pageKeywords = 'contato onda conecta, anauê design contato, telefone, whatsapp, email, endereço fortaleza, anuncie no blog'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://ondaconecta.com.br/contato',
  mainEntity: {
    '@type': 'Organization',
    name: 'Onda Conecta & Anauê Design',
    telephone: '+55-85-99627-7707',
    email: 'contato@anauedesign.com.br',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Rua Firmo Ananias Cardoso, 622',
      addressLocality: 'Sapiranga, Fortaleza',
      addressRegion: 'CE',
      postalCode: '60833-432',
      addressCountry: 'BR'
    }
  }
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <!-- Breadcrumbs -->
  <div class='border-b bg-muted/20 py-4'>
    <div class='mx-auto max-w-6xl px-4 sm:px-6 lg:px-8'>
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href='/'>Início</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>Contato</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </div>
  </div>

  <section class='py-12 sm:py-16 lg:py-20'>
    <div class='mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16'>
      
      <!-- HERO DO CONTATO -->
      <div class='text-center max-w-3xl mx-auto space-y-4'>
        <div class='inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-4 py-1.5 text-xs sm:text-sm font-semibold text-primary'>
          ✦ Canais Abertos & Atendimento Humanizado
        </div>
        <h1 class='text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl lg:text-5xl text-balance'>
          Fale com a gente. <br class='hidden sm:inline' />
          <span class='bg-gradient-to-r from-primary via-primary/80 to-blue-500 bg-clip-text text-transparent'>
            A gente adora uma boa conversa.
          </span>
        </h1>
        <p class='text-muted-foreground text-base sm:text-lg max-w-2xl mx-auto leading-relaxed'>
          Tem uma sugestão de pauta, quer tirar dúvidas, anunciar no portal ou construir um projeto digital de alto nível com a equipe da <strong>Anauê Design</strong>? Nossos canais diretos estão prontos para te atender.
        </p>
      </div>

      <!-- CARDS COM OS DADOS SOLICITADOS -->
      <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
        
        <!-- CARD WHATSAPP / TELEFONE -->
        <div class='group rounded-3xl border bg-card p-6 sm:p-8 shadow-sm transition-all duration-300 hover:border-primary/50 hover:shadow-lg flex flex-col justify-between space-y-6'>
          <div class='space-y-4'>
            <div class='h-14 w-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-2xl shadow-inner'>
              📱
            </div>
            <div class='space-y-1.5'>
              <span class='text-xs font-bold uppercase tracking-wider text-muted-foreground'>Conversa Instantânea</span>
              <h2 class='text-xl font-bold text-foreground'>Telefone & WhatsApp</h2>
              <p class='text-muted-foreground text-sm'>
                Atendimento ágil direto no WhatsApp. Sem mensagens robóticas engessadas.
              </p>
            </div>
            <div class='text-lg font-bold text-foreground pt-1'>
              +55 (85) 99627-7707
            </div>
          </div>
          <a
            href='https://wa.me/5585996277707'
            target='_blank'
            rel='noopener noreferrer'
            class='inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-4 text-sm transition-colors shadow-sm'
          >
            Abrir conversa no WhatsApp ↗
          </a>
        </div>

        <!-- CARD E-MAIL -->
        <div class='group rounded-3xl border bg-card p-6 sm:p-8 shadow-sm transition-all duration-300 hover:border-primary/50 hover:shadow-lg flex flex-col justify-between space-y-6'>
          <div class='space-y-4'>
            <div class='h-14 w-14 rounded-2xl bg-primary/10 border border-primary/20 text-primary flex items-center justify-center text-2xl shadow-inner'>
              ✉️
            </div>
            <div class='space-y-1.5'>
              <span class='text-xs font-bold uppercase tracking-wider text-muted-foreground'>Pautas & Parcerias</span>
              <h2 class='text-xl font-bold text-foreground'>E-mail Oficial</h2>
              <p class='text-muted-foreground text-sm'>
                Para comunicados de imprensa, propostas comerciais e parcerias corporativas.
              </p>
            </div>
            <div class='text-base sm:text-lg font-bold text-foreground pt-1 break-all'>
              contato@anauedesign.com.br
            </div>
          </div>
          <a
            href='mailto:contato@anauedesign.com.br'
            class='inline-flex w-full items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primary/90 text-primary-foreground font-semibold py-3 px-4 text-sm transition-colors shadow-sm'
          >
            Enviar um E-mail ↗
          </a>
        </div>

        <!-- CARD ENDEREÇO -->
        <div class='group rounded-3xl border bg-card p-6 sm:p-8 shadow-sm transition-all duration-300 hover:border-primary/50 hover:shadow-lg flex flex-col justify-between space-y-6'>
          <div class='space-y-4'>
            <div class='h-14 w-14 rounded-2xl bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center text-2xl shadow-inner'>
              📍
            </div>
            <div class='space-y-1.5'>
              <span class='text-xs font-bold uppercase tracking-wider text-muted-foreground'>Nossa Base</span>
              <h2 class='text-xl font-bold text-foreground'>Endereço Físico</h2>
              <p class='text-muted-foreground text-sm'>
                Venha tomar um café conosco na capital cearense.
              </p>
            </div>
            <div class='text-sm sm:text-base font-semibold text-foreground pt-1 leading-snug'>
              Rua Firmo Ananias Cardoso, 622 <br />
              Sapiranga, Fortaleza - CE, Brasil
            </div>
          </div>
          <a
            href='https://www.google.com/maps/search/?api=1&query=Rua+Firmo+Ananias+Cardoso,+622,+Sapiranga,+Fortaleza+-+CE'
            target='_blank'
            rel='noopener noreferrer'
            class='inline-flex w-full items-center justify-center gap-2 rounded-xl border border-input bg-background hover:bg-muted font-semibold py-3 px-4 text-sm transition-colors shadow-sm'
          >
            Ver rota no Google Maps ↗
          </a>
        </div>

      </div>

      <!-- FORMULÁRIO DE CONTATO DIRETO & HORÁRIOS -->
      <div class='grid grid-cols-1 lg:grid-cols-12 gap-8 rounded-3xl border bg-gradient-to-br from-card to-muted/30 p-8 sm:p-12'>
        
        <!-- COLUNA INFORMATIVA -->
        <div class='lg:col-span-5 space-y-6'>
          <div class='space-y-2'>
            <div class='inline-block text-xs font-bold uppercase tracking-wider text-primary'>
              ✦ Compromisso Anauê
            </div>
            <h2 class='text-2xl sm:text-3xl font-bold text-foreground'>
              Resposta rápida e time sênior de verdade
            </h2>
            <p class='text-muted-foreground text-sm sm:text-base leading-relaxed'>
              Aqui na Anauê Design e no Onda Conecta, cada mensagem é lida e respondida por pessoas que entendem do assunto.
            </p>
          </div>

          <div class='space-y-4 pt-2'>
            <div class='flex items-start gap-3.5'>
              <div class='h-8 w-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 font-bold text-sm'>
                ⚡
              </div>
              <div>
                <h3 class='text-sm font-bold text-foreground'>Até 4 horas úteis</h3>
                <p class='text-xs text-muted-foreground'>Nosso tempo médio de resposta para e-mails e contatos comerciais.</p>
              </div>
            </div>

            <div class='flex items-start gap-3.5'>
              <div class='h-8 w-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 font-bold text-sm'>
                🕒
              </div>
              <div>
                <h3 class='text-sm font-bold text-foreground'>Segunda a Sexta: 08h às 18h</h3>
                <p class='text-xs text-muted-foreground'>Horário oficial de atendimento de nossa equipe técnica e editorial.</p>
              </div>
            </div>

            <div class='flex items-start gap-3.5'>
              <div class='h-8 w-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 font-bold text-sm'>
                🤝
              </div>
              <div>
                <h3 class='text-sm font-bold text-foreground'>Parcerias de Mídia</h3>
                <p class='text-xs text-muted-foreground'>Mídia kit, publieditoriais e projetos especiais para sua marca.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- FORMULÁRIO INTERATIVO -->
        <div class='lg:col-span-7 rounded-2xl border bg-background/90 p-6 sm:p-8 shadow-sm space-y-5'>
          <h3 class='text-lg font-bold text-foreground'>Envie uma mensagem rápida</h3>
          <form class='space-y-4' onsubmit='event.preventDefault(); window.location.href="mailto:contato@anauedesign.com.br?subject=" + encodeURIComponent("Contato via Onda Conecta: " + (document.getElementById("form-subject")?.value || "Nova Mensagem")) + "&body=" + encodeURIComponent("Nome: " + (document.getElementById("form-name")?.value || "") + "\nEmail: " + (document.getElementById("form-email")?.value || "") + "\n\nMensagem:\n" + (document.getElementById("form-message")?.value || ""));'>
            <div class='grid grid-cols-1 sm:grid-cols-2 gap-4'>
              <div class='space-y-1.5'>
                <label for='form-name' class='text-xs font-semibold text-foreground'>Seu Nome</label>
                <input
                  id='form-name'
                  type='text'
                  required
                  placeholder='Ex: Maria Silva'
                  class='w-full rounded-xl border border-input bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary'
                />
              </div>
              <div class='space-y-1.5'>
                <label for='form-email' class='text-xs font-semibold text-foreground'>Seu E-mail</label>
                <input
                  id='form-email'
                  type='email'
                  required
                  placeholder='Ex: maria@empresa.com'
                  class='w-full rounded-xl border border-input bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary'
                />
              </div>
            </div>

            <div class='space-y-1.5'>
              <label for='form-subject' class='text-xs font-semibold text-foreground'>Assunto</label>
              <input
                id='form-subject'
                type='text'
                required
                placeholder='Ex: Sugestão de pauta, anúncio ou projeto digital'
                class='w-full rounded-xl border border-input bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary'
              />
            </div>

            <div class='space-y-1.5'>
              <label for='form-message' class='text-xs font-semibold text-foreground'>Mensagem</label>
              <textarea
                id='form-message'
                rows='4'
                required
                placeholder='Como podemos te ajudar hoje?'
                class='w-full resize-none rounded-xl border border-input bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary'
              ></textarea>
            </div>

            <button
              type='submit'
              class='inline-flex w-full items-center justify-center gap-2 rounded-xl bg-primary py-3 px-5 text-sm font-semibold text-primary-foreground shadow-md transition-all hover:bg-primary/90'
            >
              Enviar Mensagem para a Equipe ➔
            </button>
          </form>
        </div>

      </div>

    </div>
  </section>
</Layout>
