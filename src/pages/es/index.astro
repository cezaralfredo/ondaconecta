---
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

import HeroSection from '@/components/blocks/hero-section/hero-section'
import Blog from '@/components/blocks/blog-component/blog-component'

// Get all posts for Spanish (or fallback to all if es posts are still being populated)
const allPosts = await getCollection('blog')
const esPosts = allPosts.filter(p => p.data.lang === 'es')
const postsToShow = esPosts.length > 0 ? esPosts : allPosts

const allBlogPosts = postsToShow
  .map((post, index) => ({
    id: post.data.id || index + 1,
    slug: post.data.slug || post.id,
    title: post.data.title,
    description: post.data.description,
    imageUrl: post.data.imageUrl || '/images/blog-post/post-1.webp',
    imageAlt: post.data.imageAlt || post.data.title,
    pubDate: post.data.pubDate,
    category: post.data.category,
    author: post.data.author,
    avatarUrl: post.data.avatarUrl || '/images/avatars/post-1.webp',
    readTime: post.data.readTime || 5,
    featured: post.data.featured || false
  }))
  .sort((a, b) => b.id - a.id)

const pageTitle = 'Tendencias Globales, Noticias e Innovaciones del Mercado'
const pageDescription =
  'Descubre las últimas noticias, tendencias globales, innovaciones tecnológicas y análisis de mercado que están transformando el panorama actual.'
const pageKeywords =
  'noticias de tendencias, innovación tecnológica, mercado futuro, inteligencia artificial, sostenibilidad, negocios, onda conecta'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: 'Onda Conecta',
  description: pageDescription,
  url: 'https://ondaconecta.com.br/es',
  publishingPrinciples: 'https://ondaconecta.com.br/sobre'
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <HeroSection blogData={allBlogPosts} client:load />
  <Blog blogData={allBlogPosts} client:load />
</Layout>
