---
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

import HeroSection from '@/components/blocks/hero-section/hero-section'
import RecentPosts from '@/components/blocks/recent-posts/recent-posts'
import Blog from '@/components/blocks/blog-component/blog-component'
import AdSenseBanner from '@/components/astro/AdSenseBanner.astro'
import { normalizeCategory } from '@/consts'
import { resolveEditorialAuthor } from '@/utils/blog'

// Get all posts for Spanish (or fallback to all if es posts are still being populated)
const allPosts = await getCollection('blog')
const esPosts = allPosts.filter(p => p.data.lang === 'es')
const postsToShow = esPosts.length > 0 ? esPosts : allPosts

const allBlogPosts = postsToShow
  .map((post, index) => ({
    id: post.data.id || index + 1,
    slug: (post.data.translationOf || post.data.slug || post.id).replace(/-(en|es)$/, ''),
    title: post.data.title,
    description: post.data.description,
    imageUrl: post.data.imageUrl || '/images/blog-post/post-1.webp',
    pubDate: post.data.pubDate,
    category: normalizeCategory(post.data.category),
    author: resolveEditorialAuthor(post.data.author, post.data.category).name
  }))
  .sort((a, b) => b.id - a.id)

const latestFourPosts = allBlogPosts.slice(0, 4)

const pageTitle = 'Tendencias Globales, Noticias e Innovaciones del Mercado'
const pageDescription =
  'Descubre las últimas noticias, tendencias globales, innovaciones tecnológicas y análisis de mercado que están transformando el panorama actual.'
const pageKeywords =
  'noticias de tendencias, innovación tecnológica, mercado futuro, inteligencia artificial, sostenibilidad, negocios, onda conecta'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: 'Onda Conecta',
  description: pageDescription,
  url: 'https://ondaconecta.com.br/es',
  publishingPrinciples: 'https://ondaconecta.com.br/quem-somos'
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <HeroSection
    title={pageTitle}
    subtitle={pageDescription}
    badgeText='Radar de Tendencias e Inteligencia de Mercado'
    client:load
  />

  {/* Últimas Actualizaciones (4 últimos artículos) */}
  <RecentPosts blogData={latestFourPosts} lang='es' client:load />

  {/* Anuncio Display Google AdSense */}
  <div class='w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <AdSenseBanner />
  </div>

  <Blog blogData={allBlogPosts} lang='es' archiveHref='/es/categorias' client:load />
</Layout>
