<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirecionamento 301 definitivo de /us para /en
  RewriteRule ^us/(.*)$ /en/$1 [R=301,L]
  RewriteRule ^us/?$ /en/ [R=301,L]

  # 2. Resolução de URLs limpas geradas pelo Astro no DirectAdmin / Apache
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Configuração e cabeçalhos para validação imediata do ads.txt e robôs
<Files "ads.txt">
  ForceType "text/plain; charset=utf-8"
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>

<Files "robots.txt">
  ForceType "text/plain; charset=utf-8"
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>
