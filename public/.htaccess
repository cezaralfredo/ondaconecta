Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Redirecionamento Canônico: Forçar HTTPS e unificar www para non-www
  # Requisito explícito de verificação do robô do Google AdSense
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://ondaconecta.com.br/$1 [L,R=301]

  # 0b. Redirecionamento 301 imediato de diretórios índice /blog sem index.html (evita loop infinito DirectorySlash <-> THE_REQUEST)
  RewriteRule ^blog/?$ https://ondaconecta.com.br/categorias [R=301,L]
  RewriteRule ^en/blog/?$ https://ondaconecta.com.br/en/categories [R=301,L]
  RewriteRule ^es/blog/?$ https://ondaconecta.com.br/es/categorias [R=301,L]
  RewriteRule ^us/blog/?$ https://ondaconecta.com.br/en/categories [R=301,L]

  # 1. Normalização de Trailing Slash para URLs sem barra (alinhado com Astro trailingSlash: 'never')
  # Usa THE_REQUEST para redirecionar requisições externas com / final mesmo em diretórios estáticos do Astro sem causar loop
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)/+(?:\?[^\s]*)?\s [NC]
  RewriteRule ^ https://ondaconecta.com.br/%1 [R=301,L]

  # 2. Redirecionamento 301 definitivo de /us para /en
  RewriteRule ^us/(.*)$ https://ondaconecta.com.br/en/$1 [R=301,L]
  RewriteRule ^us/?$ https://ondaconecta.com.br/en [R=301,L]

  # 3. Redirecionamento 301 definitivo de rotas institucionais legadas
  RewriteRule ^about/?$ /quem-somos [R=301,L]
  RewriteRule ^sobre/?$ /quem-somos [R=301,L]
  RewriteRule ^contact/?$ /contato [R=301,L]
  RewriteRule ^contact-us/?$ /contato [R=301,L]
  RewriteRule ^privacy/?$ /privacidade [R=301,L]
  RewriteRule ^terms/?$ /termos-de-uso [R=301,L]
  RewriteRule ^inteligencia-artificial/?$ /servicos-ia [R=301,L]
  RewriteRule ^solucoes-ia/?$ /servicos-ia [R=301,L]

  # 4. Redirecionamento 301 de URLs legadas com sufixo -en ou -es para as rotas canônicas limpas
  RewriteRule ^blog/(.+)-en/?$ /en/blog/$1 [R=301,L]
  RewriteRule ^blog/(.+)-es/?$ /es/blog/$1 [R=301,L]
  RewriteRule ^en/blog/(.+)-en/?$ /en/blog/$1 [R=301,L]
  RewriteRule ^es/blog/(.+)-es/?$ /es/blog/$1 [R=301,L]

  # 4b. Consolidação Canônica 301 de Artigos Duplicados (Descanibalização SEO)
  RewriteRule ^(en/|es/)?blog/small-language-models-edge-ai-empresas-2026/?$ https://ondaconecta.com.br/$1blog/small-language-models-slm-npu-ia-offline-empresas-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/modelos-pequenos-ia-slm-edge-ai-empresas/?$ https://ondaconecta.com.br/$1blog/small-language-models-slm-npu-ia-offline-empresas-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/renascenca-terceiros-espacos-comunidade-desconexao/?$ https://ondaconecta.com.br/$1blog/terceiros-lugares-third-places-cafes-oficinas-convivio-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/third-places-oficinas-manuais-atelies-socializacao-urbana-brasil/?$ https://ondaconecta.com.br/$1blog/terceiros-lugares-third-places-cafes-oficinas-convivio-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/cloreto-de-magnesio-disposicao-sono-liberdade-movimento/?$ https://ondaconecta.com.br/$1blog/cloreto-de-magnesio-pa-beneficios-saude-sono-2026 [R=301,L]
  RewriteRule ^(en/|es/)?blog/funcoes-do-magnesio-no-corpo-beneficios-cloreto/?$ https://ondaconecta.com.br/$1blog/cloreto-de-magnesio-pa-beneficios-saude-sono-2026 [R=301,L]
  RewriteRule ^(en/|es/)?blog/coolcationing-turismo-clima-fresco-viagens/?$ https://ondaconecta.com.br/$1blog/coolcationing-turismo-clima-ameno-fuga-calor-viagens-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/loud-budgeting-tendencia-consumo-limites-financeiros-brasil/?$ https://ondaconecta.com.br/$1blog/loud-budgeting-transparencia-financeira-consumo-jovem-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/pdrn-estetica-regenerativa-quiet-beauty-pele/?$ https://ondaconecta.com.br/$1blog/pdrn-dna-salmao-biorregeneracao-celular-estetica-pele-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/saf-combustivel-sustentavel-aviacao-etanol-descarbonizacao/?$ https://ondaconecta.com.br/$1blog/saf-combustivel-sustentavel-aviacao-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/combustivel-sustentavel-aviacao-saf-etanol-probioqav-brasil/?$ https://ondaconecta.com.br/$1blog/saf-combustivel-sustentavel-aviacao-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/semana-de-4-dias-brasil-resultados-fgv-produtividade/?$ https://ondaconecta.com.br/$1blog/semana-de-4-dias-trabalho-produtividade-burnout-empresas-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/turismo-do-sono-hoteis-circadianos-viagens/?$ https://ondaconecta.com.br/$1blog/sleep-tourism-turismo-do-sono-hotelaria-bem-estar-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/venture-debt-startups-credito-estruturado-nao-dilutivo-brasil/?$ https://ondaconecta.com.br/$1blog/venture-debt-credito-privado-startups-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/micro-aposentadorias-pausas-sabaticas-planejamento-carreira-brasil/?$ https://ondaconecta.com.br/$1blog/micro-aposentadorias-pausas-sabaticas-geracao-z-millennials-carreira [R=301,L]
  RewriteRule ^(en/|es/)?blog/hushpitality-astroturismo-luxo-silencioso-viagens-2026/?$ https://ondaconecta.com.br/$1blog/astroturismo-noctourism-parques-ceu-escuro-hotelaria-estelar-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/astroturismo-dark-sky-parques-noturnos-chapada-veadeiros/?$ https://ondaconecta.com.br/$1blog/astroturismo-noctourism-parques-ceu-escuro-hotelaria-estelar-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/supercomputador-santos-dumont-plano-brasileiro-ia-soberana/?$ https://ondaconecta.com.br/$1blog/soberania-ia-chips-brasil-supercomputadores [R=301,L]
  RewriteRule ^(en/|es/)?blog/redata-data-centers-verdes-ia-energia-limpa-2026/?$ https://ondaconecta.com.br/$1blog/data-centers-verdes-clusters-ia-energia-limpa-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/data-centers-ia-energia-limpa-brasil-topo-global/?$ https://ondaconecta.com.br/$1blog/data-centers-verdes-clusters-ia-energia-limpa-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/ectoina-barreira-cutanea-skincare-extremolitos/?$ https://ondaconecta.com.br/$1blog/peptideos-cobre-ghk-cu-ectoina-barreira-cutanea-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/agentes-ia-open-finance-pagamentos-autonomos-2026/?$ https://ondaconecta.com.br/$1blog/open-finance-investimentos-inteligencia-artificial-rebalanceamento-brasil [R=301,L]
  RewriteRule ^(en/|es/)?blog/open-investment-carteiras-automatizadas-dividendos/?$ https://ondaconecta.com.br/$1blog/open-finance-investimentos-inteligencia-artificial-rebalanceamento-brasil [R=301,L]

  # 5. Redirecionamento 301 para rotas de categorias e ferramentas multilíngues
  # IMPORTANTE: /categorias e /ferramentas são as rotas canônicas oficiais em Português (PT-BR) e NUNCA devem ser redirecionadas
  RewriteRule ^categories/?$ /en/categories [R=301,L]
  RewriteRule ^tools/?$ /en/tools [R=301,L]
  RewriteRule ^herramientas/?$ /es/herramientas [R=301,L]
  RewriteRule ^en/categorias/?$ /en/categories [R=301,L]
  RewriteRule ^es/categories/?$ /es/categorias [R=301,L]
  RewriteRule ^en/ferramentas/?$ /en/tools [R=301,L]
  RewriteRule ^es/ferramentas/?$ /es/herramientas [R=301,L]
  RewriteRule ^en/herramientas/?$ /en/tools [R=301,L]
  RewriteRule ^es/tools/?$ /es/herramientas [R=301,L]

  # 5. Resolução de URLs limpas geradas pelo Astro no DirectAdmin / Apache
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Configuração e cabeçalhos para validação imediata do ads.txt e robôs
<Files "ads.txt">
  ForceType "text/plain; charset=utf-8"
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>

<Files "robots.txt">
  ForceType "text/plain; charset=utf-8"
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>

# Cabeçalhos de segurança e cache compatíveis com Google AdSense e Core Web Vitals no LiteSpeed/Apache
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|avif|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>
