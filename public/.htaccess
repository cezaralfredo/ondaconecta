<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Normalização de Trailing Slash para URLs sem barra (alinhado com Astro trailingSlash: 'never')
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [R=301,L]

  # 2. Redirecionamento 301 definitivo de /us para /en
  RewriteRule ^us/(.*)$ /en/$1 [R=301,L]
  RewriteRule ^us/?$ /en/ [R=301,L]

  # 3. Redirecionamento 301 de URLs legadas com sufixo -en ou -es para as rotas canônicas limpas
  RewriteRule ^blog/(.+)-en/?$ /en/blog/$1 [R=301,L]
  RewriteRule ^blog/(.+)-es/?$ /es/blog/$1 [R=301,L]
  RewriteRule ^en/blog/(.+)-en/?$ /en/blog/$1 [R=301,L]
  RewriteRule ^es/blog/(.+)-es/?$ /es/blog/$1 [R=301,L]

  # 4. Redirecionamento 301 para rotas de categorias e ferramentas multilíngues
  RewriteRule ^categories/?$ /en/categories [R=301,L]
  RewriteRule ^categorias/?$ /es/categorias [R=301,L]
  RewriteRule ^tools/?$ /en/tools [R=301,L]
  RewriteRule ^herramientas/?$ /es/herramientas [R=301,L]
  RewriteRule ^en/categorias/?$ /en/categories [R=301,L]
  RewriteRule ^es/categories/?$ /es/categorias [R=301,L]

  # 5. Resolução de URLs limpas geradas pelo Astro no DirectAdmin / Apache
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Configuração e cabeçalhos para validação imediata do ads.txt e robôs
<Files "ads.txt">
  ForceType "text/plain; charset=utf-8"
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>

<Files "robots.txt">
  ForceType "text/plain; charset=utf-8"
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>
